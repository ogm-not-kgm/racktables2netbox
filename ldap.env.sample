# ==============================================================================
# NetBox LDAP / Active Directory 連携用 環境変数設定サンプル (ldap.env.sample)
# ==============================================================================
#
# このファイルをコピーして `ldap.env` を作成し、実際の環境に合わせて編集してください。
# `ldap.env` は認証情報（パスワード等）を含むため、絶対に Git 等のリポジトリにコミットしないでください。
#
# 有効化するには、`docker-compose.yml` で以下のコメントを外して起動します。
#   env_file:
#     - ./ldap.env
#
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. 基本認証設定 (Enable/Disable Switch)
# ------------------------------------------------------------------------------
# 外部認証（LDAP）を有効化する場合は True、無効化（ローカル認証のみ）は False を指定します。
REMOTE_AUTH_ENABLED=False

# 認証バックエンドに LDAPBackend を指定します。
REMOTE_AUTH_BACKEND=netbox.authentication.LDAPBackend

# ------------------------------------------------------------------------------
# 2. LDAP / Active Directory サーバ接続設定
# ------------------------------------------------------------------------------
# 接続先サーバ URI を指定します。複数ある場合はスペース区切りで指定可能です。
# 暗号化通信を行うため、ldaps:// (ポート636) の使用を強く推奨します。
# 例 (標準LDAP): ldap://ad.example.com:389
# 例 (セキュアLDAP): ldaps://ad.example.com:636
AUTH_LDAP_SERVER_URI=ldaps://ad.example.com

# 自己署名証明書を使用していて証明書検証エラーになる場合、一時的に True にすることで検証をバイパスできます。
# ※本番環境では False にし、正しく証明書をインポートして運用することを推奨します。
LDAP_IGNORE_CERT_ERRORS=False

# START_TLS を使用する場合は True にします（ldaps:// の場合は通常 False または未指定で問題ありません）。
AUTH_LDAP_START_TLS=False

# ------------------------------------------------------------------------------
# 3. 検索用バインド（Bind）アカウント設定
# ------------------------------------------------------------------------------
# Active Directory 内を検索するためのサービスアカウントの DN (Distinguished Name) とパスワード。
# ※ADの場合、読み取り権限を持つ一般ユーザーアカウントで問題ありません。
AUTH_LDAP_BIND_DN=CN=netbox-svc,OU=Service Accounts,DC=example,DC=com
AUTH_LDAP_BIND_PASSWORD=YourServiceAccountPasswordHere

# ------------------------------------------------------------------------------
# 4. ユーザー検索設定 (Active Directory 向け)
# ------------------------------------------------------------------------------
# ログインを試みるユーザーを探す基準となるベース DN。
AUTH_LDAP_USER_SEARCH_BASEDN=OU=Users,DC=example,DC=com

# Active Directory の場合は、アカウント名属性として `sAMAccountName` を指定します。
# (デフォルトは `uid` のため、AD連携時には必ず指定する必要があります)
AUTH_LDAP_USER_SEARCH_ATTR=sAMAccountName

# ------------------------------------------------------------------------------
# 5. グループ検索・グループタイプ設定 (Active Directory 向け)
# ------------------------------------------------------------------------------
# 権限マッピング等に使用するグループを検索するベース DN。
AUTH_LDAP_GROUP_SEARCH_BASEDN=OU=Groups,DC=example,DC=com

# Active Directory のセキュリティグループの構造（ネストされたグループを含む）に対応するため、
# `NestedActiveDirectoryGroupType` を指定します。
AUTH_LDAP_GROUP_TYPE=NestedActiveDirectoryGroupType

# ------------------------------------------------------------------------------
# 6. ログイン制限と権限マッピング (任意)
# ------------------------------------------------------------------------------
# 特定のADグループに所属するユーザーのみにログインを許可する場合、グループのDNを指定します。
# AUTH_LDAP_REQUIRE_GROUP_DN=CN=NetBox Users,OU=Groups,DC=example,DC=com

# スーパーユーザー（全権限所持）を付与するADグループのDN。
AUTH_LDAP_IS_SUPERUSER_DN=CN=NetBox Admins,OU=Groups,DC=example,DC=com

# スタッフ権限（管理画面へのアクセス等の基本権限）を付与するADグループのDN。
AUTH_LDAP_IS_ADMIN_DN=CN=NetBox Staff,OU=Groups,DC=example,DC=com
