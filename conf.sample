# ====== MySQL Source (Racktables) ====== #
[MySQL]
DB_IP   = racktables.example.net
DB_PORT = 3306
DB_NAME = racktables_db
DB_USER = netbox
DB_PWD  = PASSWORD
# ====== Log settings ==================== #
[Log]
LOGFILE   = migration.log
DEBUG_LOG = debug.log
CLEAN_LOG = clean_netbox.log
ERROR_LOG = error.log
STDOUT    = True  # print to STDOUT
DEBUG     = True  # write debug log
# ====== NetBox upload settings ========= #
[NetBox]
NETBOX_TOKEN = NETBOX_API_TOKEN
NETBOX_HOST  = https://netbox.example.net
# Note: LDAP/Active Directory authentication settings for the NetBox container itself 
# should be configured using environment variables (e.g., ldap.env).
# Please refer to 'ldap.env.sample' in the project root for details.
# ====== Other settings ========= #
[Misc]
CHILD_AS_BUILDING = True  # use RTs sub-location as NetBox site/building.
ROW_AS_ROOM = True  # use RTs row as NetBox room/location.
# Note: Rooms are required because racks are mounted to rooms, not to buildings!
PDU_MOUNT = left  # Can be one of: left, right, above, below. Used for Zero-U PDU migration. Default is left
PDU_ORIENTATION = front  # can be one of: front, back. Used for Zero-U PDU migration. Default is front

# ====== Exclude Tags Settings (Optional) ========= #
# Exclude specified tags and their subtree (child tags) from migration
[ExcludeTags]
# OS = True
# Motherboard = True
# user group = True

# ====== Exclude Ports Settings (Optional) ========= #
# Exclude specific ports from migration by port name prefix or OIF type pattern
[ExcludePorts]
# Comma-separated list of port name prefixes to ignore (case-insensitive prefix match)
IGNORE_PORT_PREFIXES = USB, kvm

# Comma-separated list of OIF type keywords to ignore (case-insensitive keyword match)
IGNORE_OIF_PATTERNS = usb, kvm, virtual port

# ====== Tag Slug Mappings (Optional) ========= #
# Custom slug mappings for RackTables tag names in NetBox
[TagSlugs]
# RackTablesTagName = netbox-tag-slug
# Production = prod
# Staging = stg
# Internal = internal

# ====== Device Role Mappings (Optional) ========= #
# Map RackTables Object Types to NetBox Device Roles
[DeviceRoleMapping]
# serial console server = Console Server
# network switch = Switch
# router = Router
# network security = Firewall
# server = Server
# pdu = PDU
# patch panel = Patch Panel

# ====== Site Slug Mappings (Optional) ========= #
[SiteSlugs]
# SiteNameInRackTables = netbox-site-slug
# Tokyo Data Center = tokyo-dc1
# Osaka Data Center = osaka-dc2

# ====== Pre-defined Cluster Types (Optional) ========= #
# List of ClusterTypes to pre-create in NetBox.
# Format: ClusterTypeName = slug
[ClusterTypes]
# Proxmox VE = proxmox-ve
# Citrix XenServer = citrix-xenserver
# VMware vSphere = vmware-vsphere
# Hyper-V = hyper-v
# Generic = generic

# ====== Cluster Type Prefix Mappings (Optional) ========= #
# Match cluster name prefixes in RackTables to assign specific ClusterTypes in NetBox.
# Prefix matching is evaluated from longest prefix to shortest.
# Default ClusterType 'Generic' is used if no prefix matches.
[ClusterTypePrefixes]
# pvec = Proxmox VE
# xenpool = Citrix XenServer
# esxi = VMware vSphere

# ====== Port Type Mappings (Optional) ========= #
# Custom mapping from RackTables OIF name to NetBox interface type.
# Takes precedence over built-in mappings.
# Unknown OIFs fall back to 'other' and will be logged to error.log.
[PortTypeMapping]
# Example: Add unknown OIF names found in error.log here:
# 2.5GBase-T = 2.5gbase-t
# 5GBase-T = 5gbase-t
# 1000Base-SX = 1000base-x-sfp
# 10GBase-SR = 10gbase-x-sfpp
# virtual port = virtual

# ====== Power Port / Outlet Type Mappings (Optional) ========= #
# Custom mapping from RackTables OIF name to NetBox power_port / power_outlet type.
# AC-in default: iec-60320-c14
# AC-out default: nema-5-15r (or iec-60320-c13 if 200V)
[PowerPortTypeMapping]
# AC-in = iec-60320-c14
# DC = dc-terminal

[PowerOutletTypeMapping]
# AC-out = nema-5-15r

# ====== Device Type Library Import Settings ========= #
[DeviceTypeLibrary]
# Automatically import NetBox Device Type Library during migration (Default: True)
ENABLE_IMPORT = False
# REPO_URL = https://github.com/netbox-community/devicetype-library.git
# LOCAL_PATH = ./devicetype-library

# Automatically git-clone if not present locally (Default: False)
AUTO_CLONE = False
# Use official nb-dt-import.py script (Default: False - uses built-in YAML importer)
USE_OFFICIAL_SCRIPT = False
# Comma-separated list of specific vendors to import (empty = all vendors)
# Example: VENDORS = Cisco, Dell, Brocade
VENDORS =

# ====== Virtual Machine Object Types (Optional) ========= #
# RackTables ObjectType names or IDs to treat as NetBox VirtualMachine
[VirtualMachineObjectTypes]
# VM = True
# Zones = True
# LDOM = True
